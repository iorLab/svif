{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svif.dev/schema/capability-adapter/0.2.json",
  "title": "Svif Capability Adapter 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["svif_adapter", "adapter", "operations"],
  "properties": {
    "svif_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"const": "0.2"}}
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kinds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["workspace", "scm", "verification", "delivery", "provider", "observation", "authority", "execution_surface"]
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "effect", "authority", "retry"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "effect": {
            "enum": ["resolve", "inspect", "mutate", "identify", "verify", "actuate", "observe", "authorize", "recover", "checkpoint"]
          },
          "authority": {
            "enum": ["none", "read", "mutation", "verification", "protected-delivery", "destructive", "principal-action"]
          },
          "retry": {"enum": ["idempotent", "guarded", "unsafe", "unknown"]},
          "input_record_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "evidence-record.schema.json#/$defs/recordKind"}
          },
          "output_record_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "evidence-record.schema.json#/$defs/recordKind"}
          },
          "failure_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/failureClass"}
          }
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "purpose", "value_transport"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "minimum_scope": {"type": ["string", "null"]},
          "value_transport": {"enum": ["none", "protected-store-only", "adapter-managed"]}
        }
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "failureClass": {
      "enum": [
        "ADAPTER_UNAVAILABLE",
        "ADAPTER_UNSUPPORTED_CAPABILITY",
        "ADAPTER_CONFIGURATION_INVALID",
        "AUTHORITY_REQUIRED",
        "AUTHORITY_DENIED",
        "CREDENTIAL_UNAVAILABLE",
        "EXTERNAL_ACCOUNT_STATE",
        "DEPENDENCY_TOOLCHAIN",
        "STATE_TRANSITION_FAILURE",
        "DELIVERY_FAILURE",
        "OBSERVATION_FAILURE",
        "CANDIDATE_IDENTITY_FAILURE",
        "PROVENANCE_MISMATCH",
        "EXTERNAL_INTEGRATION_FAILURE",
        "TRANSIENT_EXTERNAL_FAILURE",
        "DESTRUCTIVE_ACTION_REQUIRES_PRINCIPAL"
      ]
    }
  }
}
