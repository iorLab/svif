{
  "svif_adapter": {"version": "0.2"},
  "adapter": {
    "id": "cloudflare.workers",
    "version": "0.2.0-dev",
    "kinds": ["delivery", "provider", "observation"]
  },
  "operations": [
    {
      "name": "deploy_verified_worker",
      "effect": "actuate",
      "authority": "protected-delivery",
      "retry": "guarded",
      "input_record_kinds": ["verification"],
      "output_record_kinds": ["delivery"],
      "failure_classes": ["AUTHORITY_REQUIRED", "CREDENTIAL_UNAVAILABLE", "PROVENANCE_MISMATCH", "DELIVERY_FAILURE", "TRANSIENT_EXTERNAL_FAILURE"]
    },
    {
      "name": "observe_worker_health",
      "effect": "observe",
      "authority": "read",
      "retry": "idempotent",
      "input_record_kinds": ["delivery"],
      "output_record_kinds": ["observation"],
      "failure_classes": ["OBSERVATION_FAILURE", "EXTERNAL_INTEGRATION_FAILURE", "TRANSIENT_EXTERNAL_FAILURE"]
    }
  ],
  "credentials": [
    {
      "reference": "protected-store://cloudflare/api-token",
      "purpose": "authorized Cloudflare Workers actuation",
      "value_transport": "protected-store-only"
    },
    {
      "reference": "protected-store://cloudflare/account-id",
      "purpose": "select the authorized Cloudflare account",
      "value_transport": "protected-store-only"
    }
  ],
  "extensions": {
    "provider": "cloudflare",
    "runtime": "workers",
    "provider_implementation": "src/svif/capabilities/cloudflare.py",
    "integration_boundary": "integrations/cloudflare/README.md"
  }
}
